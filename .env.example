# Скопируйте в .env и поменяйте пароли. Файл .env в git не коммитится.

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_USER=corag
POSTGRES_PASSWORD=corag
POSTGRES_DB=corag
# Порт на хосте, на который пробрасывается 5432 контейнера
POSTGRES_PORT=5432

# --- corag-db (DbSettings) ---
# Основная БД: сид, демо, миграции Alembic
DATABASE_URL=postgresql+asyncpg://corag:corag@localhost:5432/corag
# Тестовая БД (создаётся deploy/postgres/init.sql), её схему пересоздают тесты
TEST_DATABASE_URL=postgresql+asyncpg://corag:corag@localhost:5432/corag_test
# Печатать SQL-запросы SQLAlchemy в консоль
ECHO_SQL=false
# Размерность эмбеддингов Jina (колонка chunks.embedding VECTOR(EMBED_DIM))
EMBED_DIM=1024

# --- Сид (python -m corag_db.seed) ---
SEED_ADMIN_PASSWORD=admin12345
SEED_RESEARCHER_PASSWORD=researcher12345
# Каталог с JSON из scripts/import_text_layer.py (если файла для выпуска нет — встроенные тексты)
SEED_TEXT_LAYER_DIR=data/text_layer

# --- API Service (services/api, ApiSettings) ---
# Каталог PDF-сканов; scan_path выпуска хранится относительно него (общий том с OCR Worker в ЛР4–5)
SCANS_DIR=data/scans
# Максимальный размер скана, МБ (больше → 413; у Nginx client_max_body_size с запасом)
MAX_SCAN_MB=200
# Секрет подписи JWT (HS256), не короче 32 символов; общий с Notification Service (ЛР4).
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-0123456789abcdef0123456789abcdef
# Срок жизни access-токена, минуты
JWT_TTL_MIN=30
# Префикс API за reverse proxy: пусто при прямом доступе, /api — за Nginx (для /docs)
API_ROOT_PATH=
# Уровень логов API и RAG Service: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
# Адрес RAG Service (gRPC) и deadline вызовов, секунды: Ask, Search, IndexIssue
RAG_ADDR=localhost:50051
RAG_ASK_TIMEOUT_S=120
RAG_SEARCH_TIMEOUT_S=15
RAG_INDEX_TIMEOUT_S=1800

# --- RAG Service (services/rag, RagSettings) ---
# Порт gRPC-сервера (слушает все интерфейсы)
RAG_GRPC_PORT=50051
# Модель эмбеддингов (размерность — EMBED_DIM выше) и устройство:
# cpu по умолчанию — видеопамять нужна Ollama и DeepSeek-OCR (политика GPU, CLAUDE.md)
EMBED_MODEL=jinaai/jina-embeddings-v3
EMBED_DEVICE=cpu
# Размер пачки при индексации
EMBED_BATCH=32
# Кэш весов Hugging Face (models/ в .gitignore); первый запуск скачивает ~1,1 ГБ
HF_HOME=models/hf
# Чанкинг, в токенах токенизатора модели: размер, перекрытие, минимум для хвоста страницы
CHUNK_TOKENS=512
CHUNK_OVERLAP=64
CHUNK_MIN_TOKENS=50
# Поиск: фрагментов по умолчанию и максимум
TOP_K=5
TOP_K_MAX=20
# Порог косинусного сходства: ниже — фрагмент нерелевантен; нет ни одного → found=false без LLM.
# Замер на сиде (jina-embeddings-v3): вопросы по архиву — лучший score 0.44–0.81,
# вне архива — 0.03–0.15, близкие по теме, но которых нет в архиве — 0.22–0.29
MIN_SCORE=0.35
# Длина фрагмента (snippet) в источниках ответа, символов
SNIPPET_CHARS=300

# --- LLM (OpenAI-совместимый API; Ollama из docker-compose.dev.yml) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# Ollama ключ не проверяет; для облачного API — настоящий ключ
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.1
# Таймаут ответа LLM, секунды (не больше остатка deadline Ask)
LLM_TIMEOUT_S=90

# --- Ollama (docker-compose.dev.yml) ---
OLLAMA_PORT=11434
# Сколько модель держится в видеопамяти после запроса
OLLAMA_KEEP_ALIVE=30m
# Контекст модели в токенах (промпт: TOP_K × CHUNK_TOKENS + инструкция)
OLLAMA_CONTEXT_LENGTH=8192

# --- Nginx (docker-compose.dev.yml) ---
# Порт на хосте: http://localhost:${NGINX_PORT}/ — статика, /api/ — API
NGINX_PORT=80
