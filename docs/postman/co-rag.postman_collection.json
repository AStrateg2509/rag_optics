          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/issues?year=2015",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "issues"
              ],
              "query": [
                {
                  "key": "year",
                  "value": "2015"
                }
              ]
            }
          }
        },
        {
          "name": "Создать выпуск (admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"issue_number\", Math.floor(Date.now() / 1000) % 30000 + 1);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"issue_id\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/issues",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "issues"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 2027,\n  \"volume\": 51,\n  \"number\": \"{{issue_number}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Номер выпуска генерируется, чтобы коллекцию можно было запускать повторно."
          }
        },
        {
          "name": "Загрузить PDF-скан (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"статус uploaded\", () => pm.expect(pm.response.json().status).to.eql(\"uploaded\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/issues/{{issue_id}}/scan",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "issues",
                "{{issue_id}}",
                "scan"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "data/demo/scan.pdf"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Файл: data/demo/scan.pdf (uv run python scripts/make_test_pdf.py data/demo/scan.pdf --pages 8). В Postman путь задаётся относительно рабочего каталога (Settings → Working directory)."
          }
        },
        {
          "name": "Карточка выпуска",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/issues/{{issue_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "issues",
                "{{issue_id}}"
              ]
            }
