              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"author_id\", pm.response.json().items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
